          "expr": "(max by (silo_id, silo_name) (silo_quota:cpu_capacity{oxide_host=\"$oxide_host\", silo_name=~\"$silo_name\", silo_name!=\"\"}) or label_replace(max by (silo_id) (silo_quota:cpu_capacity{oxide_host=\"$oxide_host\", silo_name=~\"$silo_name\", silo_name=\"\"}), \"silo_name\", \"$1\", \"silo_id\", \"(.*)\"))",
